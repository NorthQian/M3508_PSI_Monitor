# =========================================================
# Keil MDK-ARM 编译中间产物
# =========================================================

# 输出目录：默认全部忽略（.o .d .map .lnp .htm .sct .dep ...）
MDK-ARM/M3508_PSI_Monitor/*
# 保留固件输出（需要一起入库的话）
!MDK-ARM/M3508_PSI_Monitor/M3508_PSI_Monitor.axf

# 散落在源码目录下的对象/依赖/列表文件
*.o
*.d
*.crf
*.dep
*.lnp
*.lst
*.htm
*.map
*.sct
*.axf.htm
*.build_log.htm

# =========================================================
# 工具 / 调试器生成的日志与缓存
# =========================================================
MDK-ARM/JLinkLog.txt
MDK-ARM/.vscode/*.log
MDK-ARM/.vscode/*.log.lock
